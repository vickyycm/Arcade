void iniciarJuego() {
  if (juegoSeleccionado == 0) {
    estadoActual = JUEGO_DONKEY_KONG;
    dibujarDonkeyKong();

    Serial.println("Iniciando Donkey Kong");
  }
  else {
    estadoActual = JUEGO_PACMAN;
    dibujarPacman();

    Serial.println("Pac-Man en desarrollo");
  }

  esperarSoltarBoton = false;
}

void volverAlMenu() {
  estadoActual = MENU_PRINCIPAL;
  juegoSeleccionado = 0;
  joystickListo = false;

  dibujarMenu();

  esperarSoltarBoton = true;

  Serial.println("Regresando al menu");
}

void actualizarBoton() {
  unsigned long ahora = millis();

  bool lectura =
    digitalRead(BTN_JUMP) == LOW;

  if (lectura != ultimaLecturaBoton) {
    ultimoCambioBoton = ahora;
  }

  ultimaLecturaBoton = lectura;

  if (ahora - ultimoCambioBoton >= REBOTE_BOTON &&
      lectura != botonEstable) {

    botonEstable = lectura;

    if (botonEstable) {
      inicioPulsacion = ahora;
      pulsacionLargaDetectada = false;
    }
    else {
      if (esperarSoltarBoton) {
        esperarSoltarBoton = false;
      }
      else if (!pulsacionLargaDetectada) {
        if (estadoActual == MENU_PRINCIPAL) {
          iniciarJuego();
        }
        else if (estadoActual == JUEGO_DONKEY_KONG) {
          iniciarSalto();
        }
      }
    }
  }

  if (botonEstable &&
      !esperarSoltarBoton &&
      !pulsacionLargaDetectada &&
      estadoActual != MENU_PRINCIPAL &&
      ahora - inicioPulsacion >= TIEMPO_MENU) {

    pulsacionLargaDetectada = true;
    volverAlMenu();
  }
}

void setup() {
  Serial.begin(115200);

  pinMode(BTN_JUMP, INPUT_PULLUP);
  pinMode(BUZZER, OUTPUT);

  pinMode(JOY_X, INPUT);
  pinMode(JOY_Y, INPUT);

  analogReadResolution(12);

  SPI.begin(TFT_SCK, -1, TFT_MOSI, TFT_CS);

  tft.begin();
  tft.setRotation(0);

  dibujarMenu();

  Serial.println("Mini Arcade v1.7.3 iniciado");
}

void loop() {
  actualizarBoton();

  switch (estadoActual) {
    case MENU_PRINCIPAL:
      actualizarMenu();
      break;

    case JUEGO_DONKEY_KONG:
      actualizarDonkeyKong();
      break;

    case JUEGO_PACMAN:
      break;
  }
}
