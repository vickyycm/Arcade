void actualizarMenu() {
  int valorY = analogRead(JOY_Y);

  if (valorY >= CENTRO_MIN &&
      valorY <= CENTRO_MAX) {
    joystickListo = true;
    return;
  }

  if (!joystickListo) return;

  int nuevaSeleccion = juegoSeleccionado;

  if (valorY > UMBRAL_ARRIBA) {
    nuevaSeleccion = 0;
    joystickListo = false;
  }
  else if (valorY < UMBRAL_ABAJO) {
    nuevaSeleccion = 1;
    joystickListo = false;
  }

  if (nuevaSeleccion != juegoSeleccionado) {
    juegoSeleccionado = nuevaSeleccion;
    actualizarSeleccionMenu();
  }
}

void dibujarEscalera(int x, int y1, int y2) {
  tft.drawFastVLine(
    x, y1, y2 - y1, ILI9341_CYAN
  );

  tft.drawFastVLine(
    x + 14, y1, y2 - y1, ILI9341_CYAN
  );

  for (int y = y1; y <= y2; y += 8) {
    tft.drawFastHLine(
      x, y, 15, ILI9341_CYAN
    );
  }
}

uint16_t colorFondo(int x, int y) {
  uint16_t color = ILI9341_BLACK;

  const int plataformas[] = {
    95, 155, 215, 275
  };

  for (int i = 0; i < 4; i++) {
    if (x >= 10 && x < 230 &&
        y >= plataformas[i] &&
        y < plataformas[i] + 7) {
      color = ILI9341_RED;
    }
  }

  const int escaleraX[] = {
    190, 38, 190
  };

  const int escaleraY1[] = {
    102, 162, 222
  };

  const int escaleraY2[] = {
    155, 215, 275
  };

  for (int i = 0; i < 3; i++) {
    int ex = escaleraX[i];
    int y1 = escaleraY1[i];
    int y2 = escaleraY2[i];

    bool lateral =
      y >= y1 && y < y2 &&
      (x == ex || x == ex + 14);

    bool peldano =
      y >= y1 && y <= y2 &&
      x >= ex && x < ex + 15 &&
      (y - y1) % 8 == 0;

    if (lateral || peldano) {
      color = ILI9341_CYAN;
    }
  }

  const int barrilX[] = {
    70, 105, 147
  };

  const int barrilY[] = {
    269, 269, 209
  };

  for (int i = 0; i < 3; i++) {
    int dx = x - barrilX[i];
    int dy = y - barrilY[i];

    if (dx * dx + dy * dy <= 36) {
      color = ILI9341_ORANGE;
    }
  }

  if (x >= 192 && x < 202 &&
      y >= 78 && y < 95) {
    color = ILI9341_MAGENTA;
  }

  int dxPauline = x - 197;
  int dyPauline = y - 72;

  if (dxPauline * dxPauline +
      dyPauline * dyPauline <= 36) {
    color = ILI9341_YELLOW;
  }

  if (x >= 20 && x < 44 &&
      y >= 75 && y < 95) {

    bool esquina = false;

    int cx = x;
    int cy = y;

    if (x < 24 && y < 79) {
      cx = 24;
      cy = 79;
      esquina = true;
    }
    else if (x >= 40 && y < 79) {
      cx = 39;
      cy = 79;
      esquina = true;
    }
    else if (x < 24 && y >= 91) {
      cx = 24;
      cy = 90;
      esquina = true;
    }
    else if (x >= 40 && y >= 91) {
      cx = 39;
      cy = 90;
      esquina = true;
    }

    if (!esquina ||
        (x - cx) * (x - cx) +
        (y - cy) * (y - cy) <= 16) {
      color = ILI9341_ORANGE;
    }
  }

  return color;
}

bool colorMario(
  int pixelX,
  int pixelY,
  int posicionX,
  int posicionY,
  uint16_t &color
) {
  int localX = pixelX - posicionX;
  int localY = pixelY - posicionY;

  if (localX < 0 ||
      localX >= MARIO_ANCHO ||
      localY < 0 ||
      localY >= MARIO_ALTO) {
    return false;
  }

  if (localY < 5) {
    color = ILI9341_RED;
    return true;
  }

  if (localX >= 1 &&
      localX <= 12 &&
      localY >= 4) {
    color = ILI9341_BLUE;
    return true;
  }

  return false;
}

void moverSpriteMario(
  int xAnterior,
  int yAnterior,
  int xNuevo,
  int yNuevo
) {
  int izquierda = min(xAnterior, xNuevo);
  int arriba = min(yAnterior, yNuevo);

  int derecha = max(
    xAnterior + MARIO_ANCHO,
    xNuevo + MARIO_ANCHO
  );

  int abajo = max(
    yAnterior + MARIO_ALTO,
    yNuevo + MARIO_ALTO
  );

  tft.startWrite();

  for (int y = arriba; y < abajo; y++) {
    for (int x = izquierda; x < derecha; x++) {

      uint16_t colorAnterior;
      uint16_t colorNuevo;

      bool teniaMario = colorMario(
        x, y,
        xAnterior, yAnterior,
        colorAnterior
      );

      bool tieneMario = colorMario(
        x, y,
        xNuevo, yNuevo,
        colorNuevo
      );

      if (!teniaMario) {
        colorAnterior = colorFondo(x, y);
      }

      if (!tieneMario) {
        colorNuevo = colorFondo(x, y);
      }

      if (colorAnterior != colorNuevo) {
        tft.writePixel(x, y, colorNuevo);
      }
    }
  }

  tft.endWrite();
}

void dibujarMario() {
  int y = (int)marioY;

  tft.fillRect(
    marioX + 1,
    y + 4,
    12,
    14,
    ILI9341_BLUE
  );

  tft.fillRect(
    marioX,
    y,
    14,
    5,
    ILI9341_RED
  );
}

void iniciarSalto() {
  if (!marioEnSuelo) {
    return;
  }

  velocidadVertical = FUERZA_SALTO;
  marioEnSuelo = false;

  ultimaFisica = millis();

  Serial.println("Mario salta");
}

void actualizarMario() {
  unsigned long ahora = millis();

  bool actualizarHorizontal =
    ahora - ultimoMovimientoMario >=
    INTERVALO_MARIO;

  bool actualizarVertical =
    ahora - ultimaFisica >=
    INTERVALO_FISICA;

  if (!actualizarHorizontal &&
      !actualizarVertical) {
    return;
  }

  int xAnterior = marioX;
  int yAnterior = (int)marioY;

  int nuevaX = marioX;
  float nuevaY = marioY;

  if (actualizarHorizontal) {
    ultimoMovimientoMario = ahora;

    int valorX = analogRead(JOY_X);

    if (valorX > 3000) {
      nuevaX -= VELOCIDAD_MARIO;
    }
    else if (valorX < 1000) {
      nuevaX += VELOCIDAD_MARIO;
    }

    nuevaX = constrain(
      nuevaX,
      MARIO_MIN_X,
      MARIO_MAX_X
    );
  }

  if (actualizarVertical) {
    ultimaFisica = ahora;

    if (!marioEnSuelo) {
      nuevaY += velocidadVertical;
      velocidadVertical += GRAVEDAD;

      if (nuevaY >= SUELO_MARIO) {
        nuevaY = SUELO_MARIO;
        velocidadVertical = 0;
        marioEnSuelo = true;

        Serial.println("Mario aterrizo");
      }
    }
  }

  int yNuevo = (int)nuevaY;

  if (nuevaX != xAnterior ||
      yNuevo != yAnterior) {

    moverSpriteMario(
      xAnterior,
      yAnterior,
      nuevaX,
      yNuevo
    );
  }

  marioX = nuevaX;
  marioY = nuevaY;
}

